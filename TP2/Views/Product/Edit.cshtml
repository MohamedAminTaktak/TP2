@model TP2.ViewModels.EditViewModel
@{
    ViewData["Title"] = $"Modifier {Model.Name}";
    string imgPath = string.IsNullOrWhiteSpace(Model.ExistingImagePath)
        ? Url.Content("~/images/noimage.svg")
        : (Model.ExistingImagePath.StartsWith("http") || Model.ExistingImagePath.StartsWith("/")
            ? Model.ExistingImagePath
            : Url.Content("~/images/" + Model.ExistingImagePath));
}

<div class="py-2">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-pencil-square text-primary me-2"></i>Modifier le Produit
            </h1>
            <p class="text-muted small mb-0">Édition des informations du produit #@Model.ProductId</p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <form asp-action="Edit" enctype="multipart/form-data" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="ExistingImagePath" />

                    <!-- Nom du produit -->
                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Nom du produit" required />
                        <label asp-for="Name">Nom du produit *</label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Prix -->
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" required />
                                <label asp-for="Price">Prix (DT) *</label>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Quantité en stock -->
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="QteStock" class="form-control" type="number" placeholder="0" required />
                                <label asp-for="QteStock">Quantité en stock *</label>
                                <span asp-validation-for="QteStock" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Catégorie -->
                    <div class="form-floating mb-4">
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required>
                            <option value="">-- Sélectionner une catégorie --</option>
                        </select>
                        <label asp-for="CategoryId">Catégorie *</label>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Existing Image & New Image Upload -->
                    <div class="card p-3 bg-light border-0 rounded-3 mb-4">
                        <label class="form-label small fw-bold text-muted mb-2">Image actuelle & Modification</label>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <img src="@imgPath" alt="@Model.Name" 
                                 class="rounded-3 border bg-white p-1" style="width: 80px; height: 80px; object-fit: contain;" 
                                 onerror="this.onerror=null;this.src='@Url.Content("~/images/noimage.svg")';" />
                            <div class="flex-grow-1">
                                <input asp-for="ImagePath" class="form-control" type="file" accept="image/*" />
                                <div class="form-text small">Laissez vide si vous souhaitez conserver l'image actuelle.</div>
                                <span asp-validation-for="ImagePath" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex align-items-center gap-3 pt-2">
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="bi bi-check-lg me-1"></i> Enregistrer les modifications
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
