@model TP2.Models.Product
@{
    ViewData["Title"] = $"Supprimer {Model.Name}";
    string imgPath = string.IsNullOrWhiteSpace(Model.Image)
        ? Url.Content("~/images/noimage.svg")
        : (Model.Image.StartsWith("http") || Model.Image.StartsWith("/")
            ? Model.Image
            : Url.Content("~/images/" + Model.Image));
}

<div class="py-2">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1 text-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Supprimer le Produit
            </h1>
            <p class="text-muted small mb-0">Confirmation de suppression du produit #@Model.ProductId</p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-danger-subtle shadow-sm rounded-4 p-4 p-md-5">
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                    <div>
                        <strong>Attention :</strong> Cette action est irréversible. Le produit sera définitivement retiré du catalogue.
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-4">
                    <img src="@imgPath" alt="@Model.Name" 
                         class="rounded-3 border bg-white p-1" style="width: 80px; height: 80px; object-fit: contain;" 
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/noimage.svg")';" />
                    <div>
                        <span class="category-pill mb-1">@(Model.Category?.CategoryName ?? "Général")</span>
                        <h4 class="fw-bold mb-1 fs-5">@Model.Name</h4>
                        <div class="text-muted small">
                            Prix : <strong>@Model.Price.ToString("N2") DT</strong> &bull; Stock : <strong>@Model.QteStock unités</strong>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductId" />

                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-danger px-4 py-2">
                            <i class="bi bi-trash3-fill me-1"></i> Supprimer définitivement
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
