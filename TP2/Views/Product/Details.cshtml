@model TP2.Models.Product
@{
    ViewData["Title"] = Model.Name;
    string imgPath = string.IsNullOrWhiteSpace(Model.Image)
        ? Url.Content("~/images/noimage.svg")
        : (Model.Image.StartsWith("http") || Model.Image.StartsWith("/")
            ? Model.Image
            : Url.Content("~/images/" + Model.Image));

    bool isOutOfStock = Model.QteStock <= 0;
    bool isLowStock = Model.QteStock > 0 && Model.QteStock <= 5;
    var similarProducts = ViewBag.SimilarProducts as IEnumerable<TP2.Models.Product> ?? Enumerable.Empty<TP2.Models.Product>();
}

<!-- ── Breadcrumb ────────────────────────────────────────────── -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb py-2 px-3 bg-white rounded-3 border small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
        @if (Model.Category != null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category.CategoryName</a>
            </li>
        }
        <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 250px;">@Model.Name</li>
    </ol>
</nav>

<!-- ── Product Details Section ───────────────────────────────── -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 g-lg-5 align-items-center">
            
            <!-- Left: Large Image with Fallback -->
            <div class="col-lg-6 text-center">
                <div class="p-4 bg-light rounded-4 d-flex align-items-center justify-content-center" style="min-height: 380px;">
                    <img src="@imgPath" alt="@Model.Name" 
                         class="img-fluid rounded-3" 
                         style="max-height: 340px; object-fit: contain;" 
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/noimage.svg")';" />
                </div>
            </div>

            <!-- Right: Details & Purchase -->
            <div class="col-lg-6">
                @if (Model.Category != null)
                {
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="category-pill mb-2">
                        @Model.Category.CategoryName
                    </a>
                }

                <h1 class="h2 fw-bold text-ink mb-2">@Model.Name</h1>

                <!-- Stock status -->
                <div class="mb-3">
                    @if (isOutOfStock)
                    {
                        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold">
                            <i class="bi bi-x-circle me-1"></i> Rupture de stock
                        </span>
                    }
                    else if (isLowStock)
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill fw-bold">
                            <i class="bi bi-exclamation-triangle me-1"></i> Plus que @Model.QteStock en stock !
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold">
                            <i class="bi bi-check-circle me-1"></i> En stock (@Model.QteStock disponibles)
                        </span>
                    }
                </div>

                <!-- Price -->
                <div class="d-flex align-items-baseline gap-2 mb-4">
                    <span class="display-6 fw-bold text-primary">@Model.Price.ToString("N2")</span>
                    <span class="fs-5 text-muted fw-bold">DT</span>
                </div>

                <p class="text-muted mb-4" style="line-height: 1.7;">
                    Produit authentique de qualité supérieure, conditionné et expédié selon les normes les plus strictes d'hygiène et de fraîcheur.
                </p>

                <!-- Add to cart form with quantity stepper -->
                @if (!isOutOfStock)
                {
                    <form asp-action="AddToCart" method="post" class="add-to-cart-form mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="d-flex align-items-center border rounded-3 bg-light p-1">
                                <button type="button" class="btn btn-sm btn-link text-dark p-2" onclick="changeQty(-1)" aria-label="Diminuer la quantité">
                                    <i class="bi bi-dash fs-5"></i>
                                </button>
                                <input type="number" id="detailQtyInput" name="quantity" value="1" min="1" max="@Model.QteStock" 
                                       class="form-control form-control-sm text-center border-0 bg-transparent fw-bold" 
                                       style="width: 50px;" readonly />
                                <button type="button" class="btn btn-sm btn-link text-dark p-2" onclick="changeQty(1)" aria-label="Augmenter la quantité">
                                    <i class="bi bi-plus fs-5"></i>
                                </button>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg px-4 flex-grow-1">
                                <i class="bi bi-cart-plus-fill me-2"></i> Ajouter au panier
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-secondary d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>Ce produit est momentanément indisponible. Revenez prochainement !</span>
                    </div>
                }

                <!-- Benefits Mini-List -->
                <div class="border-top pt-3 text-muted small d-flex flex-column gap-2 mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-truck text-primary fs-6"></i> Livraison express à domicile en 24h/48h
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-primary fs-6"></i> Garantie de fraîcheur et conformité 100%
                    </div>
                </div>

                <!-- Admin/Manager Controls -->
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span class="small fw-bold text-muted"><i class="bi bi-gear-fill me-1"></i> Options Gestionnaire</span>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Supprimer
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ── Similar Products ──────────────────────────────────────── -->
@if (similarProducts.Any())
{
    <div class="mt-5">
        <h3 class="h4 fw-bold mb-3">Produits similaires</h3>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 g-lg-4">
            @foreach (var sim in similarProducts)
            {
                <partial name="_ProductCard" model="sim" />
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function changeQty(delta) {
            var input = document.getElementById('detailQtyInput');
            if (!input) return;
            var val = parseInt(input.value) || 1;
            var max = parseInt(input.getAttribute('max')) || 999;
            var newVal = val + delta;
            if (newVal >= 1 && newVal <= max) {
                input.value = newVal;
            }
        }
    </script>
}
