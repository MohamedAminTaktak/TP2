@model TP2.Models.Product

@{
    ViewData["Title"] = "Détails du produit";
}

<h1>Détails du produit</h1>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Price) DT
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QteStock)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.QteStock)
        </dd>

        <dt class="col-sm-2">
            Catégorie
        </dt>
        <dd class="col-sm-10">
            @Model.Category?.CategoryName
        </dd>

        <dt class="col-sm-2">
            Image
        </dt>
        <dd class="col-sm-10">
            @* Afficher l'image du produit avec fallback sur noimage.jpg *@
            <img src="~/images/@(Model.Image ?? "noimage.jpg")"
                 width="100" height="100"
                 alt="@Model.Name"
                 style="object-fit: contain;" />
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
