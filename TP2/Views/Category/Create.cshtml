@model TP2.Models.Category
@{
    ViewData["Title"] = "Ajouter une Catégorie";
}

<div class="py-2">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-plus-circle text-primary me-2"></i>Nouvelle Catégorie
            </h1>
            <p class="text-muted small mb-0">Ajoutez un nouveau rayon à votre catalogue de vente.</p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                    <!-- Category Name -->
                    <div class="form-floating mb-4">
                        <input asp-for="CategoryName" class="form-control" placeholder="Nom de la catégorie" required />
                        <label asp-for="CategoryName">Nom de la catégorie *</label>
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="bi bi-check-lg me-1"></i> Enregistrer
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
