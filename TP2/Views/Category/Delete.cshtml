@model TP2.Models.Category
@{
    ViewData["Title"] = $"Supprimer {Model.CategoryName}";
    int prodCount = Model.Products?.Count ?? 0;
}

<div class="py-2">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1 text-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Supprimer la Catégorie
            </h1>
            <p class="text-muted small mb-0">Confirmation de suppression de la catégorie #@Model.CategoryId</p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-danger-subtle shadow-sm rounded-4 p-4 p-md-5">
                @if (prodCount > 0)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-shield-exclamation fs-4"></i>
                        <div>
                            <strong>Attention :</strong> Cette catégorie contient actuellement <strong>@prodCount produit(s)</strong>. Vous ne pouvez pas la supprimer tant que des produits y sont rattachés.
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                        <div>
                            <strong>Attention :</strong> Êtes-vous sûr de vouloir supprimer définitivement cette catégorie ?
                        </div>
                    </div>
                }

                <div class="p-3 bg-light rounded-3 mb-4">
                    <div class="text-muted small">Nom de la catégorie</div>
                    <div class="fw-bold fs-5 text-dark">
                        <i class="bi bi-tag-fill text-primary me-2"></i>@Model.CategoryName
                    </div>
                    <div class="text-muted small mt-2">
                        Produits associés : <strong>@prodCount</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CategoryId" />

                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-danger px-4 py-2" @(prodCount > 0 ? "disabled" : "")>
                            <i class="bi bi-trash3-fill me-1"></i> Supprimer définitivement
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
