@model TP2.Models.Order
@{
    ViewData["Title"] = $"Détails Commande #{Model.Id}";
    ViewData["HideSidebar"] = true;

    string badgeClass = Model.Status switch
    {
        "Expédiée" => "bg-primary-subtle text-primary",
        "Livrée" => "bg-success-subtle text-success",
        "Annulée" => "bg-danger-subtle text-danger",
        _ => "bg-warning-subtle text-warning-emphasis"
    };
}

<div class="py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 bg-white rounded-3 border small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
            <li class="breadcrumb-item"><a asp-action="MesCommandes">Mes commandes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Commande #@Model.Id</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">Commande #@Model.Id</h1>
                <span class="badge @badgeClass fw-bold px-3 py-1">@Model.Status</span>
            </div>
            <p class="text-muted small mb-0">Passée le @Model.OrderDate.ToString("dd MMMM yyyy à HH:mm")</p>
        </div>
        <a asp-action="MesCommandes" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour à mes commandes
        </a>
    </div>

    <div class="row g-4">
        <!-- Left: Items Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Articles commandés</h5>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Produit</th>
                                <th class="text-center">Quantité</th>
                                <th class="text-end">Prix unitaire</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.ProductName</div>
                                        @if (item.ProductId.HasValue)
                                        {
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId.Value" class="small text-primary text-decoration-none">
                                                Voir la fiche produit <i class="bi bi-box-arrow-up-right fs-8"></i>
                                            </a>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">@item.Quantity</td>
                                    <td class="text-end text-muted">@item.Price.ToString("N2") DT</td>
                                    <td class="text-end fw-bold text-dark">@((item.Quantity * item.Price).ToString("N2")) DT</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end pt-3">Frais de livraison :</th>
                                <td class="text-end pt-3 text-success fw-bold">Gratuit</td>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-end fs-5 fw-bold border-0">Total :</th>
                                <td class="text-end fs-5 fw-bold text-primary border-0 font-poppins">@Model.TotalAmount.ToString("N2") DT</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right: Shipping & Payment Summary -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt-fill text-primary"></i> Livraison
                </h5>
                <div class="mb-3">
                    <div class="text-muted small">Destinataire</div>
                    <div class="fw-bold text-dark">@Model.CustomerName</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Adresse</div>
                    <div class="fw-semibold text-dark">@Model.Address</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <div>
                        <div class="text-muted small">Téléphone</div>
                        <div class="fw-semibold text-dark">@Model.Phone</div>
                    </div>
                }
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-credit-card-fill text-primary"></i> Paiement
                </h5>
                <div class="mb-3">
                    <div class="text-muted small">Méthode choisie</div>
                    <div class="fw-bold text-dark">@Model.PaymentMethod</div>
                </div>
                <div>
                    <div class="text-muted small">Statut de la commande</div>
                    <div>
                        <span class="badge @badgeClass fw-bold px-3 py-1">@Model.Status</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
