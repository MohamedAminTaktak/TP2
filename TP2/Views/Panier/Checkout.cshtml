@model TP2.ViewModels.OrderViewModel
@{
    ViewData["Title"] = "Validation de la commande";
    ViewData["HideSidebar"] = true;
}

<div class="py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 bg-white rounded-3 border small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
            <li class="breadcrumb-item"><a asp-controller="Panier" asp-action="Index">Panier</a></li>
            <li class="breadcrumb-item active" aria-current="page">Commander</li>
        </ol>
    </nav>

    <div class="mb-4 pb-2 border-bottom">
        <h1 class="h3 fw-bold mb-1">Finaliser ma commande</h1>
        <p class="text-muted small mb-0">Renseignez vos coordonnées de livraison et votre moyen de paiement sécurisé.</p>
    </div>

    <form asp-action="Checkout" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left: Shipping & Payment Form Card -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-primary"></i> 1. Adresse de livraison
                    </h5>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Floating label Address -->
                    <div class="form-floating mb-3">
                        <textarea asp-for="Address" class="form-control" placeholder="Votre adresse complète" style="height: 100px;" required></textarea>
                        <label asp-for="Address">Adresse complète (Rue, Ville, Code postal) *</label>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <!-- Floating label Phone -->
                    <div class="form-floating mb-2">
                        <input asp-for="Phone" class="form-control" placeholder="Numéro de téléphone" type="tel" />
                        <label asp-for="Phone">Téléphone (optionnel pour la livraison)</label>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Payment Method Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card-2-front-fill text-primary"></i> 2. Méthode de paiement
                    </h5>

                    <span asp-validation-for="PaymentMethod" class="text-danger small d-block mb-2"></span>

                    <!-- Radio Card 1: Carte bancaire -->
                    <label class="payment-radio-card @(Model.PaymentMethod == "Carte bancaire" || string.IsNullOrEmpty(Model.PaymentMethod) ? "selected" : "")">
                        <input type="radio" asp-for="PaymentMethod" value="Carte bancaire" class="form-check-input mt-0" checked="@(Model.PaymentMethod == "Carte bancaire" || string.IsNullOrEmpty(Model.PaymentMethod))" />
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-credit-card text-primary fs-5"></i> Carte bancaire (Visa / Mastercard)
                            </div>
                            <div class="text-muted small">Paiement 100% sécurisé via passerelle cryptée SSL.</div>
                        </div>
                    </label>

                    <!-- Radio Card 2: PayPal -->
                    <label class="payment-radio-card @(Model.PaymentMethod == "PayPal" ? "selected" : "")">
                        <input type="radio" asp-for="PaymentMethod" value="PayPal" class="form-check-input mt-0" />
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-paypal text-primary fs-5"></i> PayPal
                            </div>
                            <div class="text-muted small">Réglez rapidement et en toute sérénité avec votre compte PayPal.</div>
                        </div>
                    </label>

                    <!-- Radio Card 3: Paiement à la livraison -->
                    <label class="payment-radio-card @(Model.PaymentMethod == "Paiement à la livraison" ? "selected" : "")">
                        <input type="radio" asp-for="PaymentMethod" value="Paiement à la livraison" class="form-check-input mt-0" />
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-cash-coin text-success fs-5"></i> Paiement à la livraison (Espèces)
                            </div>
                            <div class="text-muted small">Payez en espèces directement au livreur à réception de vos courses.</div>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Right: Sticky Order Summary Card -->
            <div class="col-lg-5">
                <div class="summary-card">
                    <h4 class="fw-bold h5 mb-3 border-bottom pb-2">Articles commandés (@Model.CartItems.Sum(i => i.Quantity))</h4>

                    <div class="d-flex flex-column gap-3 mb-4" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var item in Model.CartItems)
                        {
                            string imgPath = string.IsNullOrWhiteSpace(item.Image)
                                ? Url.Content("~/images/noimage.svg")
                                : (item.Image.StartsWith("http") || item.Image.StartsWith("/")
                                    ? item.Image
                                    : Url.Content("~/images/" + item.Image));

                            <div class="d-flex align-items-center gap-3">
                                <img src="@imgPath" alt="@item.ProductName" 
                                     class="rounded-3 border p-1" style="width: 54px; height: 54px; object-fit: contain; background: #fff;" 
                                     onerror="this.onerror=null;this.src='@Url.Content("~/images/noimage.svg")';" />
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-bold small text-truncate">@item.ProductName</div>
                                    <div class="text-muted small">Qté : @item.Quantity &times; @item.Price.ToString("N2") DT</div>
                                </div>
                                <div class="fw-bold small text-nowrap">
                                    @item.LineTotal.ToString("N2") DT
                                </div>
                            </div>
                        }
                    </div>

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Sous-total</span>
                            <span class="fw-bold">@Model.TotalAmount.ToString("N2") DT</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Frais de livraison</span>
                            <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">Gratuit</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-baseline mb-4">
                            <span class="fs-5 fw-bold">Total à payer</span>
                            <div class="text-end">
                                <span class="fs-3 fw-bold text-primary font-poppins">@Model.TotalAmount.ToString("N2")</span>
                                <span class="fs-6 fw-bold text-muted">DT</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg py-3" id="btnSubmitOrder">
                                <i class="bi bi-check-circle-fill me-1"></i> Confirmer la commande
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Modifier mon panier
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
