@model IList<TP2.Models.Order>
@{
    ViewData["Title"] = "Mes commandes";
    ViewData["HideSidebar"] = true;
}

<div class="py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 bg-white rounded-3 border small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">Mes commandes</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1">Historique de mes commandes</h1>
            <p class="text-muted small mb-0">Consultez le statut et les détails de vos achats passés.</p>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-bag-plus me-1"></i> Nouvelle commande
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Commande</th>
                            <th>Date</th>
                            <th>Articles</th>
                            <th>Paiement</th>
                            <th>Statut</th>
                            <th class="text-end">Total</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            string badgeClass = order.Status switch
                            {
                                "Expédiée" => "bg-primary-subtle text-primary",
                                "Livrée" => "bg-success-subtle text-success",
                                "Annulée" => "bg-danger-subtle text-danger",
                                _ => "bg-warning-subtle text-warning-emphasis"
                            };

                            <tr>
                                <td class="ps-4 fw-bold">#@order.Id</td>
                                <td class="text-muted small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @order.Items.Sum(i => i.Quantity) article(s)
                                    </span>
                                </td>
                                <td class="small text-muted">@order.PaymentMethod</td>
                                <td>
                                    <span class="badge @badgeClass fw-bold px-2 py-1">@order.Status</span>
                                </td>
                                <td class="text-end fw-bold text-dark font-poppins">@order.TotalAmount.ToString("N2") DT</td>
                                <td class="text-end pe-4">
                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Détails
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 px-3 bg-white rounded-4 border shadow-sm my-4">
            <div class="mb-3">
                <i class="bi bi-receipt-cutoff text-muted display-4"></i>
            </div>
            <h4 class="fw-bold mb-2">Vous n'avez pas encore passé de commande</h4>
            <p class="text-muted mb-4" style="max-width: 440px; margin: 0 auto;">
                Explorez notre boutique et effectuez votre premier achat en quelques clics.
            </p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-shop me-1"></i> Découvrir les produits
            </a>
        </div>
    }
</div>
