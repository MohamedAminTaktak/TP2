@model List<TP2.ViewModels.CartItemViewModel>
@{
    ViewData["Title"] = "Mon Panier";
    ViewData["HideSidebar"] = true;
    decimal grandTotal = Model.Sum(i => i.LineTotal);
}

<div class="py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 bg-white rounded-3 border small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Boutique</a></li>
            <li class="breadcrumb-item active" aria-current="page">Mon Panier</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1">Mon Panier</h1>
            <p class="text-muted small mb-0">
                <span id="cartItemCountHeader">@Model.Sum(i => i.Quantity)</span> article(s) dans votre sélection
            </p>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i> Continuer mes achats
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4" id="cartContentWrapper">
            <!-- Left: Cart Items List -->
            <div class="col-lg-8" id="cartLinesContainer">
                @foreach (var item in Model)
                {
                    string imgPath = string.IsNullOrWhiteSpace(item.Image)
                        ? Url.Content("~/images/noimage.svg")
                        : (item.Image.StartsWith("http") || item.Image.StartsWith("/")
                            ? item.Image
                            : Url.Content("~/images/" + item.Image));

                    <div class="cart-line-card" id="cart-row-@item.ProductId" data-product-id="@item.ProductId">
                        <!-- Thumbnail -->
                        <img src="@imgPath" alt="@item.ProductName" class="cart-thumbnail" 
                             onerror="this.onerror=null;this.src='@Url.Content("~/images/noimage.svg")';" />

                        <!-- Details -->
                        <div class="flex-grow-1 min-w-0">
                            <span class="category-pill mb-1">@(!string.IsNullOrEmpty(item.CategoryName) ? item.CategoryName : "Produit")</span>
                            <h5 class="fw-bold fs-6 mb-1 text-truncate">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">
                                    @item.ProductName
                                </a>
                            </h5>
                            <div class="text-muted small mb-2">
                                Prix unitaire : <span class="fw-semibold text-dark">@item.Price.ToString("N2") DT</span>
                            </div>

                            <!-- Quantity Stepper -->
                            <div class="d-flex align-items-center gap-3">
                                <div class="quantity-stepper">
                                    <button type="button" class="btn-step-minus" data-id="@item.ProductId" aria-label="Diminuer">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <span id="qty-@item.ProductId">@item.Quantity</span>
                                    <button type="button" class="btn-step-plus" data-id="@item.ProductId" aria-label="Augmenter">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>

                                <button type="button" class="btn btn-sm text-danger btn-remove-item p-0 border-0 bg-transparent" 
                                        data-id="@item.ProductId" title="Supprimer la ligne" aria-label="Supprimer @item.ProductName">
                                    <i class="bi bi-trash3 text-danger fs-6"></i>
                                    <span class="small d-none d-sm-inline ms-1">Supprimer</span>
                                </button>
                            </div>
                        </div>

                        <!-- Line Total -->
                        <div class="text-end ps-2">
                            <div class="small text-muted mb-1">Total ligne</div>
                            <div class="fw-bold fs-5 text-primary">
                                <span id="total-@item.ProductId">@item.LineTotal.ToString("N2")</span> <span class="small text-muted">DT</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Right: Sticky Order Summary Card -->
            <div class="col-lg-4">
                <div class="summary-card">
                    <h4 class="fw-bold h5 mb-3 border-bottom pb-2">Résumé de la commande</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Sous-total</span>
                        <span class="fw-bold"><span id="cartSubtotal">@grandTotal.ToString("N2")</span> DT</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Livraison</span>
                        <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">Gratuite</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold">Total TTC</span>
                        <div class="text-end">
                            <span class="fs-3 fw-bold text-primary font-poppins" id="cartGrandTotal">@grandTotal.ToString("N2")</span>
                            <span class="fs-6 fw-bold text-muted">DT</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="Checkout" class="btn btn-primary btn-lg py-3">
                            <i class="bi bi-lock-fill me-1"></i> Commander
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                            Continuer mes achats
                        </a>
                    </div>

                    <div class="mt-4 pt-3 border-top text-muted small d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-success fs-5"></i>
                            <span>Paiement 100% sécurisé et garanti</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-truck text-primary fs-5"></i>
                            <span>Livraison rapide à l'adresse de votre choix</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5 px-3 bg-white rounded-4 border my-4 shadow-sm" id="emptyCartView">
            <div class="mb-3">
                <img src="~/images/panier_vide.svg" alt="Panier vide" style="max-width: 180px; width: 100%; height: auto;" 
                     onerror="this.onerror=null;this.src='@Url.Content("~/images/noimage.svg")';" />
            </div>
            <h3 class="fw-bold mb-2">Votre panier est actuellement vide</h3>
            <p class="text-muted mb-4" style="max-width: 440px; margin: 0 auto;">
                Découvrez des centaines d'articles de qualité et commencez vos achats dès maintenant pour profiter de nos meilleures offres.
            </p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-bag-plus me-1"></i> Découvrir les produits
            </a>
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        $(function () {
            var token = $('input[name="__RequestVerificationToken"]').val();

            function checkEmptyCart() {
                if ($('#cartLinesContainer .cart-line-card').length === 0) {
                    location.reload();
                }
            }

            // Plus Product
            $(document).on('click', '.btn-step-plus', function () {
                var btn = $(this);
                var id = btn.data('id');
                btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("PlusProduct", "Panier")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) {
                            $('#qty-' + id).text(res.quatite);
                            $('#total-' + id).text(res.totalRow);
                            $('#cartSubtotal').text(res.total);
                            $('#cartGrandTotal').text(res.total);
                            $('#cartItemCountHeader').text(res.cartCount);
                            if (window.updateCartBadge) window.updateCartBadge(res.cartCount);
                            else $('#cartBadge').text(res.cartCount);
                        } else if (res.message) {
                            alert(res.message);
                        }
                    },
                    complete: function () {
                        btn.prop('disabled', false);
                    }
                });
            });

            // Minus Product
            $(document).on('click', '.btn-step-minus', function () {
                var btn = $(this);
                var id = btn.data('id');
                btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("MinusProduct", "Panier")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) {
                            if (res.ct === 0) {
                                // Ligne supprimée (smooth fade)
                                var row = $('#cart-row-' + id);
                                row.addClass('removing');
                                setTimeout(function () {
                                    row.remove();
                                    checkEmptyCart();
                                }, 300);
                            } else {
                                $('#qty-' + id).text(res.quatite);
                                $('#total-' + id).text(res.totalRow);
                            }
                            $('#cartSubtotal').text(res.total);
                            $('#cartGrandTotal').text(res.total);
                            $('#cartItemCountHeader').text(res.cartCount);
                            if (window.updateCartBadge) window.updateCartBadge(res.cartCount);
                            else $('#cartBadge').text(res.cartCount);
                        }
                    },
                    complete: function () {
                        btn.prop('disabled', false);
                    }
                });
            });

            // Remove Product
            $(document).on('click', '.btn-remove-item', function () {
                var btn = $(this);
                var id = btn.data('id');

                $.ajax({
                    url: '@Url.Action("RemoveProduct", "Panier")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function (res) {
                        if (res.success) {
                            var row = $('#cart-row-' + id);
                            row.addClass('removing');
                            setTimeout(function () {
                                row.remove();
                                $('#cartSubtotal').text(res.total);
                                $('#cartGrandTotal').text(res.total);
                                $('#cartItemCountHeader').text(res.cartCount);
                                if (window.updateCartBadge) window.updateCartBadge(res.cartCount);
                                else $('#cartBadge').text(res.cartCount);
                                checkEmptyCart();
                            }, 300);
                        }
                    }
                });
            });
        });
    </script>
}
