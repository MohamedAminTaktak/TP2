@model TP2.ViewModels.EditRoleViewModel
@{
    ViewData["Title"] = $"Modifier {Model.RoleName}";
    ViewData["HideSidebar"] = true;
}

<div class="py-2">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-shield-shaded text-primary me-2"></i>Modifier le Rôle
            </h1>
            <p class="text-muted small mb-0">Configuration du rôle et des membres associés.</p>
        </div>
        <a asp-action="ListRoles" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour aux rôles
        </a>
    </div>

    <div class="row g-4">
        <!-- Left: Edit Role Name -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 h-100">
                <h5 class="fw-bold mb-3">Informations du rôle</h5>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                    <input type="hidden" asp-for="Id" />

                    <!-- ID (read-only) -->
                    <div class="mb-3">
                        <label class="form-label small text-muted">ID interne du rôle</label>
                        <input asp-for="Id" class="form-control bg-light" disabled />
                    </div>

                    <!-- Role Name -->
                    <div class="form-floating mb-4">
                        <input asp-for="RoleName" class="form-control" placeholder="Nom du rôle" required />
                        <label asp-for="RoleName">Nom du rôle *</label>
                        <span asp-validation-for="RoleName" class="text-danger small"></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="bi bi-check-lg me-1"></i> Enregistrer
                        </button>
                        <a asp-action="ListRoles" class="btn btn-outline-secondary px-4 py-2">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right: Users in Role -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Utilisateurs dans ce rôle</h5>
                    <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">
                        @Model.Users.Count membre(s)
                    </span>
                </div>

                <div class="flex-grow-1 mb-4">
                    @if (Model.Users.Any())
                    {
                        <ul class="list-group list-group-flush rounded-3 border">
                            @foreach (var user in Model.Users)
                            {
                                <li class="list-group-item d-flex align-items-center gap-2 py-2">
                                    <i class="bi bi-person-check-fill text-success fs-5"></i>
                                    <span class="fw-semibold text-dark">@user</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 bg-light rounded-3 text-center text-muted">
                            <i class="bi bi-people text-muted fs-2 d-block mb-2"></i>
                            Aucun utilisateur n'est assigné à ce rôle pour l'instant.
                        </div>
                    }
                </div>

                <div>
                    <a asp-controller="Admin" asp-action="EditUsersInRole" asp-route-roleId="@Model.Id" class="btn btn-outline-primary w-100 py-2">
                        <i class="bi bi-person-gear me-1"></i> Gérer les utilisateurs du rôle
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
