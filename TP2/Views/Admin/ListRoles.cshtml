@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "Gestion des Rôles";
    ViewData["HideSidebar"] = true;
}

<div class="py-2">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-shield-check text-primary me-2"></i>Gestion des Rôles & Accès
            </h1>
            <p class="text-muted small mb-0">Définissez les autorisations et les rôles utilisateurs du système.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Orders" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-receipt me-1"></i> Commandes
            </a>
            <a asp-action="CreateRole" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Nouveau Rôle
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var role in Model)
            {
                <div class="col">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-2">
                                    Rôle Système
                                </span>
                                <h4 class="fw-bold fs-5 text-dark mb-0">@role.Name</h4>
                            </div>
                            <div class="text-muted small">
                                <i class="bi bi-key-fill text-muted"></i>
                            </div>
                        </div>

                        <div class="text-muted small mb-4 flex-grow-1">
                            ID interne : <code class="text-secondary small">@role.Id</code>
                        </div>

                        <div class="border-top pt-3 d-flex justify-content-between align-items-center gap-2">
                            <a asp-action="EditRole" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                                <i class="bi bi-pencil me-1"></i> Configurer
                            </a>

                            @if (role.Name != "Admin")
                            {
                                <form method="post" asp-action="DeleteRole" asp-route-id="@role.Id" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le rôle « @role.Name » ?');" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer le rôle">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 px-3 bg-white rounded-4 border shadow-sm my-4">
            <i class="bi bi-people text-muted display-4 mb-3 d-block"></i>
            <h4 class="fw-bold mb-2">Aucun rôle enregistré</h4>
            <p class="text-muted mb-4">Créez votre premier rôle utilisateur.</p>
            <a asp-action="CreateRole" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Créer un rôle
            </a>
        </div>
    }
</div>
