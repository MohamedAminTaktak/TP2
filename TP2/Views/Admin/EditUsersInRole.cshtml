@using TP2.ViewModels
@model List<UserRoleViewModel>
@{
    var roleId = ViewBag.roleId;
    ViewData["Title"] = "Gérer les membres du rôle";
    ViewData["HideSidebar"] = true;
}

<div class="py-2">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Gérer les Utilisateurs du Rôle
            </h1>
            <p class="text-muted small mb-0">Cochez ou décochez les utilisateurs à assigner à ce rôle.</p>
        </div>
        <a asp-action="EditRole" asp-route-id="@roleId" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour au rôle
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="list-group rounded-3 border mb-4">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <label class="list-group-item d-flex align-items-center gap-3 py-3" style="cursor: pointer;">
                                <input type="hidden" asp-for="@Model[i].UserId" />
                                <input type="hidden" asp-for="@Model[i].UserName" />
                                <input asp-for="@Model[i].IsSelected" class="form-check-input mt-0 fs-5" />
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark">@Model[i].UserName</div>
                                    <div class="text-muted small">ID: @Model[i].UserId</div>
                                </div>
                            </label>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="bi bi-check-lg me-1"></i> Enregistrer les affectations
                        </button>
                        <a asp-action="EditRole" asp-route-id="@roleId" class="btn btn-outline-secondary px-4 py-2">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
