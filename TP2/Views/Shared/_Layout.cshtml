@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TP2 Shop — Votre boutique en ligne moderne, rapide et sécurisée." />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} – TP2 Shop" : "TP2 Shop – Vos courses en ligne")</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Design System Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ── Toast Notifications Container ────────────────────────── -->
    <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true">
        @if (TempData["ToastSuccess"] != null || TempData["SuccessMessage"] != null)
        {
            <div class="custom-toast" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="flex-grow-1 font-weight-500">
                    @(TempData["ToastSuccess"] ?? TempData["SuccessMessage"])
                </div>
                <button type="button" class="btn-close btn-sm" onclick="this.parentElement.remove()" aria-label="Fermer"></button>
            </div>
        }
        @if (TempData["ToastError"] != null || TempData["ErrorMessage"] != null)
        {
            <div class="custom-toast toast-error" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="flex-grow-1 font-weight-500">
                    @(TempData["ToastError"] ?? TempData["ErrorMessage"])
                </div>
                <button type="button" class="btn-close btn-sm" onclick="this.parentElement.remove()" aria-label="Fermer"></button>
            </div>
        }
        @if (TempData["ToastInfo"] != null)
        {
            <div class="custom-toast" role="alert">
                <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                <div class="flex-grow-1 font-weight-500">
                    @TempData["ToastInfo"]
                </div>
                <button type="button" class="btn-close btn-sm" onclick="this.parentElement.remove()" aria-label="Fermer"></button>
            </div>
        }
    </div>

    <!-- ── Sticky Header & Navbar ──────────────────────────────── -->
    <header class="navbar-custom">
        <div class="container-xxl">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap flex-lg-nowrap">
                
                <!-- Brand & Categories Toggle -->
                <div class="d-flex align-items-center gap-2">
                    <button class="btn-categories-toggle" id="btnCategoriesToggle" type="button" 
                            aria-label="Afficher ou masquer les catégories" title="Catégories">
                        <i class="bi bi-grid-fill text-primary"></i>
                        <span class="d-none d-sm-inline">Rayons</span>
                    </button>

                    <a class="navbar-brand-logo text-decoration-none" asp-controller="Home" asp-action="Index">
                        <div class="brand-icon">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                        <span>TP2 Shop<span class="brand-dot">.</span></span>
                    </a>
                </div>

                <!-- Centered Search Form (Pill) -->
                <form class="nav-search-form d-none d-md-block flex-grow-1 mx-lg-4" asp-controller="Product" asp-action="Index" method="get">
                    <input class="form-control nav-search-input" type="search" name="search" 
                           placeholder="Rechercher un produit, une marque..." 
                           value="@Context.Request.Query["search"]" 
                           aria-label="Rechercher des produits" />
                    <button class="nav-search-btn" type="submit" aria-label="Lancer la recherche">
                        <i class="bi bi-search"></i>
                    </button>
                </form>

                <!-- Navigation Links & User Actions -->
                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <ul class="nav d-none d-lg-flex align-items-center gap-1 mb-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Product" asp-action="Index">Produits</a>
                        </li>

                        @* Admin & Manager Dropdown *@
                        @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("Manager")))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-custom dropdown-toggle d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock-fill text-primary"></i> Administration
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">
                                    <li><h6 class="dropdown-header text-uppercase fs-7 text-muted">Gestion Catalogue</h6></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Product" asp-action="Index">
                                            <i class="bi bi-box-seam text-primary"></i> Gérer les Produits
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Category" asp-action="Index">
                                            <i class="bi bi-tags text-primary"></i> Gérer les Catégories
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-uppercase fs-7 text-muted">Ventes & Sécurité</h6></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Admin" asp-action="Orders">
                                                <i class="bi bi-receipt text-success"></i> Commandes
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Admin" asp-action="ListRoles">
                                                <i class="bi bi-people text-info"></i> Rôles & Utilisateurs
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Cart Button with Live Badge -->
                    <a asp-controller="Panier" asp-action="Index" class="nav-cart-btn" id="cartNavBtn" aria-label="Voir mon panier">
                        <i class="bi bi-cart3 fs-5"></i>
                        @await Component.InvokeAsync("CartBadge")
                    </a>

                    <!-- User Account / Auth -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var userName = User.Identity?.Name ?? "U";
                        var initial = userName.Substring(0, 1).ToUpper();

                        <div class="dropdown">
                            <button class="user-avatar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar-circle">@initial</div>
                                <span class="d-none d-xl-inline text-truncate" style="max-width: 120px;">@userName.Split('@')[0]</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="small text-muted">Connecté en tant que</div>
                                    <div class="fw-bold text-truncate">@userName</div>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Panier" asp-action="MesCommandes">
                                        <i class="bi bi-bag-check text-primary"></i> Mes commandes
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item d-flex align-items-center gap-2 text-danger py-2 w-100 border-0 bg-transparent">
                                            <i class="bi bi-box-arrow-right"></i> Déconnexion
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-person"></i> Connexion
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm d-none d-sm-inline-flex">
                                Inscription
                            </a>
                        </div>
                    }

                    <!-- Mobile Menu Toggler (Offcanvas) -->
                    <button class="btn btn-sm d-lg-none p-1 border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavOffcanvas" aria-controls="mobileNavOffcanvas" aria-label="Menu Mobile">
                        <i class="bi bi-list fs-3 text-ink"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Search Bar (Only visible on small screens) -->
            <div class="d-md-none mt-2 pt-1">
                <form class="nav-search-form w-100" asp-controller="Product" asp-action="Index" method="get">
                    <input class="form-control nav-search-input py-2" type="search" name="search" 
                           placeholder="Rechercher un produit..." 
                           value="@Context.Request.Query["search"]" 
                           aria-label="Rechercher" />
                    <button class="nav-search-btn" type="submit" aria-label="Rechercher">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>
        </div>
    </header>

    <!-- ── Mobile Navigation Offcanvas ──────────────────────────── -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileNavOffcanvas" aria-labelledby="mobileNavLabel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title d-flex align-items-center gap-2 font-poppins" id="mobileNavLabel">
                <i class="bi bi-bag-check-fill text-primary"></i> TP2 Shop
            </h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav flex-column gap-2 mb-4">
                <li class="nav-item">
                    <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-2"></i> Accueil
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-custom" asp-controller="Product" asp-action="Index">
                        <i class="bi bi-boxes me-2"></i> Produits
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-custom" asp-controller="Panier" asp-action="Index">
                        <i class="bi bi-cart me-2"></i> Mon Panier
                    </a>
                </li>
                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Panier" asp-action="MesCommandes">
                            <i class="bi bi-receipt me-2"></i> Mes commandes
                        </a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li class="nav-item mt-3">
                            <span class="text-uppercase text-muted small fw-bold px-3">Administration</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-box-seam me-2"></i> Produits
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Category" asp-action="Index">
                                <i class="bi bi-tags me-2"></i> Catégories
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Orders">
                                    <i class="bi bi-receipt me-2"></i> Commandes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="ListRoles">
                                    <i class="bi bi-people me-2"></i> Rôles
                                </a>
                            </li>
                        }
                    }
                }
            </ul>

            <div class="border-top pt-3">
                @if (SignInManager.IsSignedIn(User))
                {
                    <form method="post" asp-controller="Account" asp-action="Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Déconnexion
                        </button>
                    </form>
                }
                else
                {
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Connexion</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Inscription</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ── Mobile Categories Offcanvas ──────────────────────────── -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasCategories" aria-labelledby="offcanvasCategoriesLabel">
        <div class="offcanvas-header border-bottom bg-light">
            <h5 class="offcanvas-title font-poppins d-flex align-items-center gap-2" id="offcanvasCategoriesLabel">
                <i class="bi bi-grid-fill text-primary"></i> Rayons & Catégories
            </h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body p-0">
            @await Component.InvokeAsync("CategoriesMenu")
        </div>
    </div>

    <!-- ── Main Page Content ────────────────────────────────────── -->
    <div class="container-xxl py-4 flex-grow-1">
        <div class="row g-4" id="layoutMainRow">
            @if (ViewData["HideSidebar"] as bool? != true)
            {
                <!-- Sticky Desktop Categories Sidebar -->
                <aside class="col-lg-3 col-xl-2 d-none d-lg-block sidebar-col" id="desktopSidebarCol">
                    <div class="sidebar-sticky-card">
                        @await Component.InvokeAsync("CategoriesMenu")
                    </div>
                </aside>

                <!-- Page Main Column -->
                <main role="main" class="col-12 col-lg-9 col-xl-10 content-col" id="desktopContentCol">
                    @RenderBody()
                </main>
            }
            else
            {
                <main role="main" class="col-12">
                    @RenderBody()
                </main>
            }
        </div>
    </div>

    <!-- ── Footer ───────────────────────────────────────────────── -->
    <footer class="footer-custom">
        <div class="container-xxl">
            <div class="row g-4 justify-content-between">
                
                <!-- Col 1: Brand & Presentation -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon bg-white text-dark p-2 rounded-3 fs-5" style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;">
                            <i class="bi bi-bag-check-fill text-primary"></i>
                        </div>
                        <span class="font-poppins fw-bold fs-4 text-white">TP2 Shop</span>
                    </div>
                    <p class="text-white-50 pe-lg-4 mb-3" style="line-height: 1.6;">
                        Votre supermarché en ligne préféré. Retrouvez des milliers de produits de qualité supérieure aux meilleurs prix du marché, livrés directement à votre porte.
                    </p>
                    <div class="d-flex gap-3 text-white fs-5">
                        <a href="#" class="text-white-50 hover-white" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white-50 hover-white" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white-50 hover-white" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>

                <!-- Col 2: Quick Links -->
                <div class="col-lg-3 col-md-6">
                    <h5>Navigation Rapide</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right fs-7 me-1"></i> Accueil</a></li>
                        <li><a asp-controller="Product" asp-action="Index"><i class="bi bi-chevron-right fs-7 me-1"></i> Nos Produits</a></li>
                        <li><a asp-controller="Panier" asp-action="Index"><i class="bi bi-chevron-right fs-7 me-1"></i> Mon Panier</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy"><i class="bi bi-chevron-right fs-7 me-1"></i> Politique de confidentialité</a></li>
                    </ul>
                </div>

                <!-- Col 3: Contact & Customer Support -->
                <div class="col-lg-4 col-md-6">
                    <h5>Service Client & Contact</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-white-50">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-accent"></i> Tunis, Tunisie
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-fill text-accent"></i> +216 71 000 000
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-accent"></i> contact@tp2shop.tn
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-fill text-accent"></i> 7j/7 de 8h00 à 22h00
                        </li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>&copy; 2026 TP2 Shop. Tous droits réservés.</div>
                <div class="text-white-50 small">Paiements 100% sécurisés | Livraison partout en Tunisie</div>
            </div>
        </div>
    </footer>

    <!-- ── Scripts ──────────────────────────────────────────────── -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
