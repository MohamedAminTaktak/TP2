@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
    ViewData["HideSidebar"] = true;
}

<div class="auth-wrapper my-5">
    <div class="auth-card text-center py-5">
        <div class="mb-3 d-inline-flex align-items-center justify-content-center" 
             style="width: 80px; height: 80px; border-radius: 50%; background: #fee2e2; color: #ef4444;">
            <i class="bi bi-exclamation-triangle-fill display-5"></i>
        </div>
        <h1 class="h3 fw-bold text-danger mb-2">Une erreur inattendue est survenue</h1>
        <p class="text-muted small mb-4" style="line-height: 1.6;">
            Nous sommes désolés, une difficulté technique s'est produite lors du traitement de votre requête. Notre équipe a été avertie.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="p-3 bg-light rounded-3 small text-muted mb-4 text-break">
                Identifiant de requête : <code>@Model.RequestId</code>
            </div>
        }

        <div class="d-grid gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door me-1"></i> Retour à l'accueil
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-shop me-1"></i> Voir les produits
            </a>
        </div>
    </div>
</div>
